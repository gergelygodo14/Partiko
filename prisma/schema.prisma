// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id            String   @id @default(cuid())
  name          String
  unit          String
  unitPrice     Int
  profitPerUnit Int?
  order         Int      @default(0)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  entries       Entry[]
}

model Entry {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  date         DateTime
  quantity     Float
  createdAt    DateTime   @default(now())

  @@index([ingredientId, date])
}

model BillingPeriod {
  id       String   @id @default(cuid())
  from     DateTime
  to       DateTime
  closedAt DateTime @default(now())
}

model WeeklyMenu {
  id          String    @id @default(cuid())
  weekStart   DateTime  @unique
  days        Json
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Szállítási kör szerinti csoportosítás, korábban két helyen volt hardkódolva:
// sandwichVidekStores.ts (5 szó szerinti név) és a groupFavAndCoopAdjacent()
// név-regexe a generateSandwichOrdersXlsx.ts-ben. A VIDEK erősebb a COOP-nál:
// a "COOP MÓRA" vidéki bolt a Coop előtag ellenére, és a régi kód csak azért
// kezelte helyesen, mert a vidéket szűrte ki előbb.
enum StoreGroup {
  FAV
  COOP
  EGYEB
  VIDEK
  // Iskolák - önálló, fix heti rendeléses kör (2026-08-24 óta), ugyanúgy
  // teljesen külön kezelve mint a VIDEK: saját blokk a rendelésfelvételi
  // rácson és saját lap(ok) a konyhai exportban, sosem keveredik a városi
  // boltokkal.
  ISKOLA
}

model Customer {
  id             String          @id @default(cuid())
  storeName      String
  companyName    String
  // Szendvics-kiszállítási metaadat. A csak-készétel ügyfelek az EGYEB/0
  // alapértéken maradnak; a szendvics-képernyőkön kívül semmi nem olvassa.
  storeGroup     StoreGroup      @default(EGYEB)
  storeOrder     Int             @default(0)
  createdAt      DateTime        @default(now())
  orders         Order[]
  sandwichOrders SandwichOrder[]
  sandwichFixOrders SandwichFixOrder[]

  @@index([storeName, companyName])
  @@index([storeGroup, storeOrder])
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  weekStart  DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  lines      OrderLine[]

  @@unique([customerId, weekStart])
}

model OrderLine {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dayIndex Int
  letter   String
  isXl     Boolean @default(false)
  quantity Int

  @@unique([orderId, dayIndex, letter, isXl])
  @@index([orderId])
}

enum Supplier {
  SAJTFUTAR
  BAROMFIUDVAR
}

enum ProductStatus {
  PENDING
  CONFIRMED
}

enum InvoiceStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum PriceSource {
  EMAIL_PRICELIST
  INVOICE_PHOTO
  MANUAL
  NAV
}

model Product {
  id                String             @id @default(cuid())
  name              String
  unit              String?
  // Hány alap-egység (pl. db) van egy "doboz"/"karton"/"csomag" mértékegységben
  // ennél a terméknél - ha be van állítva, az ilyen mértékegységű PriceObservation-ök
  // ára ennyivel osztva jelenik meg az ár-összehasonlításban, hogy összevethető legyen
  // egy másik beszállító darab-áras tételével.
  packSize          Int?
  status            ProductStatus      @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  priceObservations PriceObservation[]

  @@index([status])
}

model PriceObservation {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  supplier     Supplier
  unitPrice    Int
  unit         String?
  observedDate DateTime
  source       PriceSource
  rawText      String?
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([productId, observedDate])
  @@index([supplier, observedDate])
}

model Invoice {
  id                String             @id @default(cuid())
  // Optional since 2026-09-08: a NAV row from a supplier OUTSIDE the 2-
  // supplier price-tracking scope (see NAV_SUPPLIER_TAX_NUMBER in
  // navInvoiceIngestion.ts) has no Supplier enum value to hold - it's a
  // "ledger-only" row (see supplierName/supplierTaxNumber below), recorded
  // for the "Összes számla"/Kiadások expense reporting only, never for price
  // comparison. Still always set for photo uploads and the 2 tracked
  // suppliers' NAV rows.
  supplier          Supplier?
  // NAV's own supplier tax number and display name, set for every NAV-sourced
  // row (tracked or not) - supplierTaxNumber is the real dedup key (a raw
  // navInvoiceNumber string can collide across two different suppliers' own
  // numbering schemes, so [supplier, navInvoiceNumber] alone wasn't safe
  // once untracked suppliers - which have no `supplier` enum value at all -
  // entered the picture). supplierName is what the "Összes számla" ledger
  // displays for a row outside the 2 tracked suppliers (they get the app's
  // own friendly label instead - see supplierDisplayName in expenseSummary.ts).
  // Both null for photo-uploaded rows.
  supplierTaxNumber String?
  supplierName      String?
  // Optional since 2026-09-07: a NAV-sourced row (see navInvoiceNumber below)
  // has no photo at all - only a photo-upload row sets this.
  photoUrl          String?
  photoBlobPathname String?
  // NAV Online Számla's own invoice number, set only for rows imported via
  // the NAV integration (src/lib/navInvoiceIngestion.ts) - null for
  // photo-uploaded rows, same pattern as PriceListImportRun.emailMessageId.
  navInvoiceNumber  String?
  // The following three are populated only for NAV-sourced rows (from
  // queryInvoiceDigest/queryInvoiceData - src/lib/navInvoiceIngestion.ts,
  // 2026-09-08), null for photo-uploaded rows since neither the AI vision
  // extraction nor NAV itself gives us a per-invoice total from that path.
  // issueDate is the invoice's own date (distinct from uploadedAt, which is
  // just when this app happened to import it) - the "Összes számla" ledger
  // and the Riportok "Kiadások" report both group by this, not uploadedAt.
  issueDate         DateTime?
  netAmountHUF      Int?
  vatAmountHUF      Int?
  status            InvoiceStatus      @default(UPLOADED)
  uploadedAt        DateTime           @default(now())
  processedAt       DateTime?
  rawExtraction     Json?
  summaryText       String?
  // Just the short "what changed price" block (buildHighlightSummary),
  // stored separately from summaryText so the /szamlak page can show the
  // latest invoice's price-change highlight in its own block at the top of
  // the page, without having to parse it back out of the full summary text.
  highlightText     String?
  errorMessage      String?
  // Extracted line items whose price differs a lot (see
  // LARGE_PRICE_CHANGE_THRESHOLD in invoiceProcessing.ts) from the last
  // observation of the matched product - held back from priceObservations
  // until the owner confirms the AI actually read them correctly, instead of
  // silently trusting a number that might be a misread. Cleared out (item
  // removed from the array) once confirmed or rejected.
  pendingLineItems  Json?
  priceObservations PriceObservation[]
  createdAt         DateTime           @default(now())

  // Postgres treats multiple NULLs as distinct, so this only actually
  // constrains the NAV-sourced rows (photo-upload rows all have
  // navInvoiceNumber: null and never collide with each other or with this).
  // Keyed on supplierTaxNumber, not the supplier enum (see above) - an
  // untracked-supplier row has no enum value to key on.
  @@unique([supplierTaxNumber, navInvoiceNumber])
  @@index([issueDate])
}

model PriceListImportRun {
  id             String   @id @default(cuid())
  emailMessageId String   @unique
  supplier       Supplier
  productCount   Int
  importedAt     DateTime @default(now())
}

// Catalog of real, previously-used dish names (seeded from the Drive
// menülisták corpus) that the weekly-menu "AI" suggestion button picks
// from - it never invents a name, only selects an existing one.
model Dish {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model SandwichItem {
  id            String                 @id @default(cuid())
  name          String
  price         Int
  profitFt      Int                    @default(0)
  order         Int                    @default(0)
  archived      Boolean                @default(false)
  createdAt     DateTime               @default(now())
  orderLines    SandwichOrderLine[]
  fixOrderLines SandwichFixOrderLine[]
}

// "Fix rendelés" - amit egy bolt szokásosan rendel egy adott hétköznapon.
// Egyszer betöltve a rendelések.xlsx napi füleiből, utána a felületen
// szerkeszthető. Szándékosan NEM SandwichOrder: nincs dátuma, nincs
// ár-pillanatképe, és egyetlen összesítésben/exportban sem jelenik meg.
// A nulla soros rekord értelmes állapot: a bolt rajta van az adott nap
// körén, csak nincs beállított mennyisége.
model SandwichFixOrder {
  id         String                 @id @default(cuid())
  customerId String
  customer   Customer               @relation(fields: [customerId], references: [id])
  weekday    Int // 0=hétfő .. 4=péntek
  active     Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  lines      SandwichFixOrderLine[]

  @@unique([customerId, weekday])
  @@index([weekday, active])
}

// Itt szándékosan NINCS unitPriceFt (a SandwichOrderLine-nal ellentétben):
// a sablon nem eladás, nincs mit pillanatképezni. Az ár-pillanatkép csak
// akkor keletkezik, amikor a sablonból valódi SandwichOrder lesz.
model SandwichFixOrderLine {
  id         String           @id @default(cuid())
  fixOrderId String
  fixOrder   SandwichFixOrder @relation(fields: [fixOrderId], references: [id], onDelete: Cascade)
  itemId     String
  item       SandwichItem     @relation(fields: [itemId], references: [id])
  quantity   Int

  @@unique([fixOrderId, itemId])
  @@index([fixOrderId])
}

model SandwichOrder {
  id         String              @id @default(cuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  orderDate  DateTime
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  lines      SandwichOrderLine[]

  @@unique([customerId, orderDate])
  @@index([orderDate])
}

// unitPriceFt snapshots SandwichItem.price at order time - the catalog price
// is admin-editable, so a later price change must not retroactively change
// historical Ft totals on old orders (same reasoning as PriceObservation).
model SandwichOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       SandwichOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String
  item        SandwichItem  @relation(fields: [itemId], references: [id])
  quantity    Int
  unitPriceFt Int

  @@unique([orderId, itemId])
  @@index([orderId])
}

// What was actually sent to the bakery (UNIBREAD) for a given day, via the
// "Pékáru rendelés" flow - one row per day, overwritten (upsert) if sent
// again for the same date. Lets /rendelesfelvetel compare "what we told the
// bakery to bring" against the live sandwich-order totals for that day.
model SandwichBakeryOrder {
  id     String   @id @default(cuid())
  date   DateTime @unique
  rows   Json // BakeryOrderRow[] ({ label, toOrder }[])
  sentAt DateTime @default(now())
}
