// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id        String   @id @default(cuid())
  name      String
  unit      String
  unitPrice Int
  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  entries   Entry[]
}

model Entry {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  date         DateTime
  quantity     Float
  createdAt    DateTime   @default(now())

  @@index([ingredientId, date])
}

model BillingPeriod {
  id       String   @id @default(cuid())
  from     DateTime
  to       DateTime
  closedAt DateTime @default(now())
}

model WeeklyMenu {
  id          String    @id @default(cuid())
  weekStart   DateTime  @unique
  days        Json
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Szállítási kör szerinti csoportosítás, korábban két helyen volt hardkódolva:
// sandwichVidekStores.ts (5 szó szerinti név) és a groupFavAndCoopAdjacent()
// név-regexe a generateSandwichOrdersXlsx.ts-ben. A VIDEK erősebb a COOP-nál:
// a "COOP MÓRA" vidéki bolt a Coop előtag ellenére, és a régi kód csak azért
// kezelte helyesen, mert a vidéket szűrte ki előbb.
enum StoreGroup {
  FAV
  COOP
  EGYEB
  VIDEK
}

model Customer {
  id             String          @id @default(cuid())
  storeName      String
  companyName    String
  // Szendvics-kiszállítási metaadat. A csak-készétel ügyfelek az EGYEB/0
  // alapértéken maradnak; a szendvics-képernyőkön kívül semmi nem olvassa.
  storeGroup     StoreGroup      @default(EGYEB)
  storeOrder     Int             @default(0)
  createdAt      DateTime        @default(now())
  orders         Order[]
  sandwichOrders SandwichOrder[]
  sandwichFixOrders SandwichFixOrder[]

  @@index([storeName, companyName])
  @@index([storeGroup, storeOrder])
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  weekStart  DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  lines      OrderLine[]

  @@unique([customerId, weekStart])
}

model OrderLine {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dayIndex Int
  letter   String
  isXl     Boolean @default(false)
  quantity Int

  @@unique([orderId, dayIndex, letter, isXl])
  @@index([orderId])
}

enum Supplier {
  SAJTFUTAR
  BAROMFIUDVAR
}

enum ProductStatus {
  PENDING
  CONFIRMED
}

enum InvoiceStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum PriceSource {
  EMAIL_PRICELIST
  INVOICE_PHOTO
  MANUAL
}

model Product {
  id                String             @id @default(cuid())
  name              String
  unit              String?
  // Hány alap-egység (pl. db) van egy "doboz"/"karton"/"csomag" mértékegységben
  // ennél a terméknél - ha be van állítva, az ilyen mértékegységű PriceObservation-ök
  // ára ennyivel osztva jelenik meg az ár-összehasonlításban, hogy összevethető legyen
  // egy másik beszállító darab-áras tételével.
  packSize          Int?
  status            ProductStatus      @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  priceObservations PriceObservation[]

  @@index([status])
}

model PriceObservation {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  supplier     Supplier
  unitPrice    Int
  unit         String?
  observedDate DateTime
  source       PriceSource
  rawText      String?
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([productId, observedDate])
  @@index([supplier, observedDate])
}

model Invoice {
  id                String             @id @default(cuid())
  supplier          Supplier
  photoUrl          String
  photoBlobPathname String?
  status            InvoiceStatus      @default(UPLOADED)
  uploadedAt        DateTime           @default(now())
  processedAt       DateTime?
  rawExtraction     Json?
  summaryText       String?
  // Just the short "what changed price" block (buildHighlightSummary),
  // stored separately from summaryText so the /szamlak page can show the
  // latest invoice's price-change highlight in its own block at the top of
  // the page, without having to parse it back out of the full summary text.
  highlightText     String?
  errorMessage      String?
  priceObservations PriceObservation[]
  createdAt         DateTime           @default(now())
}

model PriceListImportRun {
  id             String   @id @default(cuid())
  emailMessageId String   @unique
  supplier       Supplier
  productCount   Int
  importedAt     DateTime @default(now())
}

// Catalog of real, previously-used dish names (seeded from the Drive
// menülisták corpus) that the weekly-menu "AI" suggestion button picks
// from - it never invents a name, only selects an existing one.
model Dish {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model SandwichItem {
  id            String                 @id @default(cuid())
  name          String
  price         Int
  profitFt      Int                    @default(0)
  order         Int                    @default(0)
  archived      Boolean                @default(false)
  createdAt     DateTime               @default(now())
  orderLines    SandwichOrderLine[]
  fixOrderLines SandwichFixOrderLine[]
}

// "Fix rendelés" - amit egy bolt szokásosan rendel egy adott hétköznapon.
// Egyszer betöltve a rendelések.xlsx napi füleiből, utána a felületen
// szerkeszthető. Szándékosan NEM SandwichOrder: nincs dátuma, nincs
// ár-pillanatképe, és egyetlen összesítésben/exportban sem jelenik meg.
// A nulla soros rekord értelmes állapot: a bolt rajta van az adott nap
// körén, csak nincs beállított mennyisége.
model SandwichFixOrder {
  id         String                 @id @default(cuid())
  customerId String
  customer   Customer               @relation(fields: [customerId], references: [id])
  weekday    Int // 0=hétfő .. 4=péntek
  active     Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  lines      SandwichFixOrderLine[]

  @@unique([customerId, weekday])
  @@index([weekday, active])
}

// Itt szándékosan NINCS unitPriceFt (a SandwichOrderLine-nal ellentétben):
// a sablon nem eladás, nincs mit pillanatképezni. Az ár-pillanatkép csak
// akkor keletkezik, amikor a sablonból valódi SandwichOrder lesz.
model SandwichFixOrderLine {
  id         String           @id @default(cuid())
  fixOrderId String
  fixOrder   SandwichFixOrder @relation(fields: [fixOrderId], references: [id], onDelete: Cascade)
  itemId     String
  item       SandwichItem     @relation(fields: [itemId], references: [id])
  quantity   Int

  @@unique([fixOrderId, itemId])
  @@index([fixOrderId])
}

model SandwichOrder {
  id         String              @id @default(cuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  orderDate  DateTime
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  lines      SandwichOrderLine[]

  @@unique([customerId, orderDate])
  @@index([orderDate])
}

// unitPriceFt snapshots SandwichItem.price at order time - the catalog price
// is admin-editable, so a later price change must not retroactively change
// historical Ft totals on old orders (same reasoning as PriceObservation).
model SandwichOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       SandwichOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String
  item        SandwichItem  @relation(fields: [itemId], references: [id])
  quantity    Int
  unitPriceFt Int

  @@unique([orderId, itemId])
  @@index([orderId])
}
